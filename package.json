{
  "name": "one",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm format:check",
    "core": "node core/src/index.ts",
    "core:cli": "node core/src/cli-main.ts",
    "core:package": "node scripts/package-core.mjs",
    "provider:local": "node packages/provider-local/src/main.ts",
    "client": "node scripts/client.mjs",
    "client:pet": "node scripts/client.mjs pet",
    "client:desktop": "node scripts/client.mjs desktop",
    "pet:dev": "node scripts/client.mjs pet --dev",
    "desktop:dev": "node scripts/client.mjs desktop --dev",
    "desktop:build": "tauri build --no-bundle",
    "env:check": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "22.20.5",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
