node_modules/
dist/
# 本体的可分发产物（pnpm core:package）：里面那份 node.exe 有 80MB 以上，
# 是构建出来的东西，不是源码。壳在发布时从打包资源里取，不从仓库里取。
dist-runtime/
target/
src-tauri/gen/
# Mobile icon output is generated by `tauri icon` but unused while bundle.active = false.
src-tauri/icons/android/
src-tauri/icons/ios/
src-tauri/icons/icon.icns
.env
.env.*
!.env.example
coverage/
*.log
# 联调时抓的运行输出与截图；它们是排查记录，不是源码。
dev*.txt
pet-*.txt
one-*.txt
core-*.log
core-*.txt
shot*.png
pet-*.png
probe.png
tmp.png
# 领域验收的临时产物（d3-out*.json 等），只用来肉眼核对返回值。
d3-*.json
d3-*.txt
scripts/.fix-codes.mjs
.DS_Store
.idea/
.one/
